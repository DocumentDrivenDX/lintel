{
  "format": "lintel.host/1",
  "mount": "/graphql",
  "introspection": true,
  "limits": {
    "defaultPage": 25,
    "maxPage": 100,
    "maxLookup": 100,
    "relationshipBatch": 100,
    "maxRelationshipHops": 1,
    "maxDepth": 8,
    "maxFieldOccurrences": 256,
    "maxAliases": 32,
    "maxCost": 10000,
    "maxMutationFields": 4,
    "maxConcurrentDispatch": 8,
    "requestBytes": 1048576,
    "responseBytes": 8388608,
    "documentBytes": 262144,
    "deadlineMs": 30000,
    "nodeIdBytes": 2048,
    "cursorBytes": 4096,
    "invocationKeyBytes": 128
  }
}
