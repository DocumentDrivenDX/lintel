{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lintel:prepared-api:1",
  "title": "Build-issued Lintel prepared API inventory",
  "description": "Structural closure only. Canonical digests, source semantics, independent receipt and host capability truth require admission checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifactId", "artifactDigest", "application", "identityNamespace", "exposureBase64", "exposureSha256", "sources", "capabilities", "hostProfile", "bindingProfile", "scalarCodecProfile", "records", "sdl", "schemaDigest", "apiDigest"],
  "properties": {
    "version": {"const": "lintel.prepared-api/1"},
    "artifactId": {"type": "string", "minLength": 1, "maxLength": 256},
    "artifactDigest": {"$ref": "#/$defs/sha256"},
    "application": {"type": "string", "minLength": 1},
    "identityNamespace": {"type": "string", "minLength": 1},
    "exposureBase64": {"type": "string", "contentEncoding": "base64"},
    "exposureSha256": {"$ref": "#/$defs/sha256"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["identity", "sha256"], "properties": {"identity": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "capabilities": {"$ref": "#/$defs/pairs"},
    "hostProfile": {"type": "object", "additionalProperties": false, "required": ["mount", "introspection", "limits"], "properties": {"mount": {"type": "string", "pattern": "^/(?:[A-Za-z0-9_-]+/)*graphql$"}, "introspection": {"type": "boolean"}, "limits": {"$ref": "#/$defs/pairs"}}},
    "bindingProfile": {"type": "string", "minLength": 1},
    "scalarCodecProfile": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "sdl": {"type": "string", "minLength": 1},
    "schemaDigest": {"$ref": "#/$defs/sha256"},
    "apiDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pair": {"type": "array", "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string", "minLength": 1}], "items": false, "minItems": 2, "maxItems": 2},
    "pairs": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["module", "element"], "properties": {"module": {"type": "string", "minLength": 1}, "element": {"type": "string", "minLength": 1}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["module", "id", "kind"], "properties": {"module": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["table", "action"]}}},
    "field": {"type": "object", "additionalProperties": false, "required": ["source", "name", "scalar", "nullable"], "properties": {"source": {"$ref": "#/$defs/ref"}, "name": {"type": "string", "pattern": "^(?!__)[_A-Za-z][_0-9A-Za-z]*$"}, "scalar": {"enum": ["string", "boolean", "integer", "decimal", "uuid", "date", "timestamp"]}, "nullable": {"type": "boolean"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["source", "keyId", "keyFields", "typeName", "lookup", "fields"], "properties": {"source": {"$ref": "#/$defs/ref"}, "keyId": {"type": "string", "minLength": 1}, "keyFields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "typeName": {"type": "string", "pattern": "^(?!__)[_A-Za-z][_0-9A-Za-z]*$"}, "lookup": {"$ref": "#/$defs/operation"}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}}}
  }
}
